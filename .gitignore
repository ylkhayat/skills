# Deny everything, then allow only the skills that ship. Anything not named below —
# other skills, settings, credentials-adjacent state, transcripts, per-project memory —
# is never staged, so a private skill cannot be added to this repo by accident.
/*
!/.gitignore
!/README.md
!/.claude-plugin/
!/skills/
/skills/*
!/skills/ai-ethics/
!/skills/linear-comment/
!/skills/linear-ticket/
!/skills/review-exchange/
!/skills/review-pr/
!/skills/revise/
!/skills/brief-ticket/
!/skills/check-stack/
!/skills/drive-stack/
!/skills/check-understanding/
!/skills/explain-change/
!/skills/explain-codebase/
!/skills/explain-domain/
!/skills/improve-skills/
!/skills/plan-project/
!/skills/plan-stacks/
!/skills/pr-turns/
!/skills/settle-intent/
!/skills/ship-tickets/
!/skills/simplify-stack-steps/
!/skills/stack-tour/
!/skills/work-from-concierge/
!/skills/write-standup/

# Build noise
__pycache__/
*.pyc
*.bak
# Your filled-in copy stays local; config.example.md ships.
/skills/review-exchange/config.md
